<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.AssassinsCreedValhalla"
             Title="AssassinsCreedValhalla">
    <VerticalStackLayout>
        <Label
                Text="Assassins Creed Valhalla"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <Label Text="In Stock"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="ForestGreen" />
            <Image
                Source="assassinscreedvalhalla.jpg"
                HeightRequest="200"
                Aspect="AspectFit" />
            <Label
                Text="Assassin's Creed Valhalla is an action role-playing video game developed by Ubisoft Montreal and published by Ubisoft. It is the twelfth major installment in the Assassin's Creed series and was released on November 10, 2020."
                FontSize="16"
                HorizontalOptions="Center" />
            <Label
                   Text="$59.99"
                   FontSize="16"
                   HorizontalOptions="Center" />
        <Entry x:Name="QuantityEntry"
               Placeholder="Enter quantity"
               Keyboard="Numeric"
               FontSize="16"
               HorizontalOptions="Center" />
        <Button Text="Add to Cart"
                    FontSize="20"
                    HeightRequest="56"
                    BackgroundColor="#512BD4"
                    Clicked="OnAddToCartClicked" />
            <Label x:Name="ResultLabel"
                   IsVisible="False"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="ForestGreen"
                   HorizontalOptions="Center" />

    </VerticalStackLayout>
</ContentPage>