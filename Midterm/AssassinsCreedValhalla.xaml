<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.AssassinsCreedValhalla"
             Title="AssassinsCreedValhalla">
    <VerticalStackLayout>
        <Grid
            RowDefinitions="Auto, Auto, Auto"
            ColumnDefinitions="*, *">
            <Label
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Text="Assassins Creed Valhalla"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <Image
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Source="assassins_creed_valhalla.jpg"
                Aspect="AspectFit" />
            <Label
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Text="Assassin's Creed Valhalla is an action role-playing video game developed by Ubisoft Montreal and published by Ubisoft. It is the twelfth major installment in the Assassin's Creed series and was released on November 10, 2020."
                FontSize="16"
                HorizontalOptions="Center" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>