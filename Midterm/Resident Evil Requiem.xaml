<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.Resident_Evil_Requiem"
             Title="Resident_Evil_Requiem">
    <VerticalStackLayout>
        <Label
                    Text="Resident Evil Requiem"
                    FontSize="24"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
                <Image
                    Source="requiem.jpg"
                    HeightRequest="200"
                    Aspect="AspectFit" />
                <Label
                    Text="Resident Evil Requiem is a survival horror film directed by Paul W.S. Anderson. It is the fourth installment in the Resident Evil film series and was released on September 14, 2017."
                    FontSize="16"
                    HorizontalOptions="Center" />
            <Label
                Text="$59.99"
                FontSize="16"
                HorizontalOptions="Center" />
        <Label x:Name="ResultLabel"
                   IsVisible="False"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="ForestGreen"
                   HorizontalOptions="Center" />
        <Button Text="Add to Cart"
                    FontSize="20"
                    HeightRequest="56"
                    BackgroundColor="#512BD4"
                    Clicked="OnAddToCartClicked" />
    </VerticalStackLayout>
</ContentPage>