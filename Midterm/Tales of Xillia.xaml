<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.Tales_of_Xillia"
             Title="Tales_of_Xillia">
    <VerticalStackLayout>
        <Label
                Text="Tales of Xillia"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <Image
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Source="talesofxillia.jpg"
                HeightRequest="200"
                Aspect="AspectFit" />
            <Label
                Text="Tales of Xillia is a role-playing video game developed and published by Bandai Namco Games. It is the thirteenth main entry in the Tales series and was released on September 7, 2011."
                FontSize="16"
                HorizontalOptions="Center" />
        <Label x:Name="ResultLabel"
                   IsVisible="False"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="ForestGreen"
                   HorizontalOptions="Center" />
        <Label
            Text="$19.99"
            FontSize="16"
            HorizontalOptions="Center" />
        <Button Text="Add to Cart"
                FontSize="20"
                HeightRequest="56"
                BackgroundColor="#512BD4"
                Clicked="OnAddToCartClicked"
                HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>