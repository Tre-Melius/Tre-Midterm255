<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.Checkoutpage"
             Title="Checkoutpage">
    <ScrollView>
        <VerticalStackLayout>
            <Label
                Text="Checkout Page"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <CollectionView
                x:Name="CartListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout>
                            <Label Text="{Binding .}" FontSize="16" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label
                Text =" Total: $0.00"
                x:Name="TotalLabel"/>
            <Button
                x:Name="CheckoutButton"
                Text="Checkout"
                Clicked="CheckoutButton_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>