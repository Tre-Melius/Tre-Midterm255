<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterm.Dragon_Age_Origins"
             Title="Dragon_Age_Origins">
    <VerticalStackLayout>
        <Label
                Text="Dragon Age Origins"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center" />
            <Image
                Source="dragonageorigins.jpg"
                HeightRequest="200"
                Aspect="AspectFit" />
            <Label
                Text="Dragon Age Origins is an action role-playing video game developed by BioWare and published by EA Games. It is the first installment in the Dragon Age series and was released on October 6, 2011."
                FontSize="16"
                HorizontalOptions="Center" />
            <Label
                Text="$20.00"
                FontSize="16"
                HorizontalOptions="Center" />
        <Label Text = "Out of Stock"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="Red"
                   HorizontalOptions="Center" />


            <Button Text = "Out of Stock"
                FontSize="20"
                HeightRequest="56"
                BackgroundColor="Gray"
                TextColor="White"
                IsEnabled="False" />
    </VerticalStackLayout>
</ContentPage>